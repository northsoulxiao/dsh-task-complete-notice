  "plugins": [
    {
      "name": "dsh-task-complete-notice",
      "title": {
        "en": "Task completion notice",
        "zh": "任务完成提示"
      },
      "description": {
        "en": "Plays a sound and shows a Windows desktop notification when a turn finishes: the title carries the workspace folder, the body the last reply and the elapsed time. Subagent turns stay silent by default, and the notification can open as a corner window instead of a toast. Sound, style, wording, minimum turn duration and the notification sender are configurable. Windows 10/11 only; nothing is sent anywhere.",
        "zh": "每个轮次结束时播放提示音，并在 Windows 桌面弹出通知：标题带工作区目录名，正文是本轮最后一段回答和用时。子代理的轮次默认静默，通知也可以改成右下角小窗。提示音、通知形式、文案、最短提示时长和通知显示的应用名都能配置。仅支持 Windows 10/11，不向任何地方发送数据。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "John Xiao",
