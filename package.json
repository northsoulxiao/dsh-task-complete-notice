{
  "name": "dsh-task-complete-notice",
  "version": "1.0.1",
  "description": "Plays a sound and shows a Windows desktop notification when a DeepSeek Harness turn finishes, with the workspace name, the last reply and the elapsed time.",
  "license": "MIT",
  "author": "John Xiao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/northsoulxiao/dsh-task-complete-notice.git"
  },
  "bugs": {
    "url": "https://github.com/northsoulxiao/dsh-task-complete-notice/issues"
  },
  "homepage": "https://github.com/northsoulxiao/dsh-task-complete-notice#readme",
  "type": "module",
  "main": "lib/index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast",
    "reminder",
    "windows"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0",
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
